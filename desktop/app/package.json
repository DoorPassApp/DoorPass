{
  "name": "doorpass",
  "productName": "DoorPass",
  "version": "0.2.0",
  "description": "DoorPass for macOS and Windows, based on Jigsaw's Intra: encrypted DNS (DNS-over-HTTPS) and TLS splitting against blocking.",
  "main": "main.js",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.bfast.doorpass",
    "productName": "DoorPass",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "helper-client.js",
      "servers.json",
      "renderer/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "helper/${os}-${arch}",
        "to": "helper"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": null,
      "target": "dmg"
    },
    "dmg": {
      "artifactName": "DoorPass-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "DoorPass-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
